#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>

/ {
    behaviors {
        ht: hold_tap {
            label = "hold_tap";
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <200>;
            quick-tap-ms = <200>;
            global-quick-tap;
            bindings = <&kp>, <&kp>;
        };

       td_shift: tap_dance_0 {
           compatible = "zmk,behavior-tap-dance";
           label = "TAP_DANCE_0";
           #binding-cells = <0>;
           tapping-term-ms = <200>;
           bindings = <&kp LSHFT>, <&kp CAPS>;

       };
       td_apos: tap_dance_1 {
           compatible = "zmk,behavior-tap-dance";
           label = "TAP_DANCE_1";
           #binding-cells = <0>;
           tapping-term-ms = <200>;
           bindings = <&kp RA(APOS)>, <&kp RS(RA(DQT))>;

       };
    };

    macros {
        sp_dqt: sp_dqt {
            label = "double quotes";
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <40>;
            tap-ms = <40>;
            bindings = <&kp DQT>, <&kp SPACE>;
        };
        sp_apos: sp_apos {
            label = "apos with space";
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <40>;
            tap-ms = <40>;
            bindings = <&kp APOS>, <&kp SPACE>;
        };
        sp_grave: sp_grave {
            label = "gave with space";
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <40>;
            tap-ms = <40>;
            bindings = <&kp GRAVE>, <&kp SPACE>;
        };
        sp_caret: sp_caret {
            label = "caret with space";
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <40>;
            tap-ms = <40>;
            bindings = <&kp CARET>, <&kp SPACE>;
        };
    };



    combos {
            compatible = "zmk,combos";
            combo_layer4 {
                timeout-ms = <50>;
                key-positions = <31 32>;
                bindings = <&mo 3>;
            };
        };

    keymap {
        compatible = "zmk,keymap";
        default_layer {
            bindings = <
        //╭──────────┬──────────┬──────────┬──────────┬──────────╮   ╭──────────┬──────────┬──────────┬──────────┬──────────╮
        //│  Q       │  W       │  F       │  P       │  B       │   │  J       │  L       │  U       │  Z       │          │
            &kp Q      &kp W        &kp F   &kp P      &kp B          &kp J         &kp L       &kp U    &kp Z    &kp SEMI
        //├──────────┼──────────┼──────────┼──────────┼──────────┤   ├──────────┼──────────┼──────────┼──────────┼──────────┤
        //│  A       │  R       │  S       │  T       │  G       │   │  M       │  N       │  E       │  I       │ O        │
            &kp A      &kp R        &kp S       &kp T   &kp G          &kp M      &kp N         &kp E     &kp I     &kp O
        //├──────────┼──────────┼──────────┼──────────┼──────────┤   ├──────────┼──────────┼──────────┼──────────┼──────────┤
        //│  Y       │  X       │  C       │  D       │  V       │   │  K       │  H       │          │          │          │
            &ht LGUI Y &ht LALT X &ht LCTRL C &ht LSHFT D  &kp V        &kp K      &ht LSHFT H   &ht LCTRL COMMA   &ht LALT DOT  &ht LGUI MINUS
        //╰──────────┴──────────┴──────────┼──────────┼──────────┤   ├──────────┼──────────┼──────────┴──────────┴──────────╯
                                             &kp ENTER  &mo 2             &mo 1  &kp SPACE
        //                                 ╰──────────┴──────────╯   ╰──────────┴──────────╯
            >;
        };

        first_layer {
            bindings = <
            //╭──────────┬──────────┬──────────┬──────────┬──────────╮   ╭──────────┬──────────┬──────────┬──────────┬──────────╮
            //│          │          │          │          │          │   │          │          │          │          │          │
            &kp AT     &kp LBKT &kp LBRC &kp LPAR       &kp FSLH       &kp BSLH  &kp RPAR  &kp RBRC  &kp RBKT  &kp RA(GRAVE)
            //├──────────┼──────────┼──────────┼──────────┼──────────┤   ├──────────┼──────────┼──────────┼──────────┼──────────┤
            //│          │          │          │          │          │   │          │          │          │          │
            &kp N0     &kp N1    &kp N2     &kp N3    &kp N4             &kp N5    &kp N6     &kp N7     &kp N8      &kp N9
            //├──────────┼──────────┼──────────┼──────────┼──────────┤   ├──────────┼──────────┼──────────┼──────────┼──────────┤
&ht LGUI PLUS &ht LALT STAR &ht LCTRL RA(TILDE) &ht LSHFT PRCNT  &kp EQUAL  &kp PIPE  &ht LSHFT AMPS &ht LCTRL RA(APOS)  &ht LALT EXCL  &ht LGUI QMARK
            //╰──────────┴──────────┴──────────┼──────────┼──────────┤   ├──────────┼──────────┼──────────┴──────────┴──────────╯
                                                &kp BSPC     &kp SPACE      &trans     &bootloader
            //                                 ╰──────────┴──────────╯   ╰──────────┴──────────╯
            >;
        };

        second_layer {
            bindings = <
            //╭──────────┬──────────┬──────────┬──────────┬──────────╮   ╭──────────┬──────────┬──────────┬──────────┬──────────╮
            //│          │          │          │          │          │   │          │          │          │          │          │
            &kp RA(Q)     &trans    &trans      &kp RA(P)  &kp DLLR        &kp LS(TAB) &kp PAGE_DOWN &kp PAGE_UP &kp TAB &kp ESC
            //├──────────┼──────────┼──────────┼──────────┼──────────┤   ├──────────┼──────────┼──────────┼──────────┼──────────┤
            //│          │          │          │          │          │   │          │          │          │          │
              &trans    &kp HASH     &kp RA(S) &kp RA(CARET) &kp RS(RA(DQT))  &kp LEFT    &kp DOWN    &kp UP    &kp RIGHT  &kp DEL
            //├──────────┼──────────┼──────────┼──────────┼──────────┤   ├──────────┼──────────┼──────────┼──────────┼──────────┤
            //│          │          │          │          │          │   │          │          │          │          │          │
                &ht LGUI RA(Y)  &kp LALT    &kp LCTRL   &kp LSHFT  &trans   &kp HOME &ht LSHFT CAPS &ht LCTRL PSCRN &ht LALT END  &ht LGUI DEL
            //╰──────────┴──────────┴──────────┼──────────┼──────────┤   ├──────────┼──────────┼──────────┴──────────┴──────────╯
                                                &bootloader   &trans      &trans     &kp BSPC
            //                                 ╰──────────┴──────────╯   ╰──────────┴──────────╯
            >;
        };


        third_layer {
            bindings = <
        //╭──────────┬──────────┬──────────┬──────────┬──────────╮   ╭──────────┬──────────┬──────────┬──────────┬──────────╮
        //│          │          │          │          │          │   │          │          │          │          │          │
            &kp F12     &kp F7    &kp F8     &kp F9    &trans       &bt BT_CLR &bt BT_SEL 0  &bt BT_SEL 1     &trans     &trans
        //├──────────┼──────────┼──────────┼──────────┼──────────┤   ├──────────┼──────────┼──────────┼──────────┼──────────┤
        //│          │          │          │          │          │   │          │          │          │          │
            &kp F11  &kp F4     &kp F5     &kp F6     &trans         &trans     &kp C_BRI_DN  &kp C_BRI_UP     &trans     &trans
        //├──────────┼──────────┼──────────┼──────────┼──────────┤   ├──────────┼──────────┼──────────┼──────────┼──────────┤
        //│          │          │          │          │          │   │          │          │          │          │          │
            &kp F10     &kp F1    &kp F2     &kp F3    &trans        &trans      &kp LSHFT   &kp LCTRL  &kp LALT  &kp LGUI
        //╰──────────┴──────────┴──────────┼──────────┼──────────┤   ├──────────┼──────────┼──────────┴──────────┴──────────╯
                                             &trans     &trans      &trans     &trans
        //                                 ╰──────────┴──────────╯   ╰──────────┴──────────╯
            >;
        };

        last_layer {
            bindings = <
            //╭──────────┬──────────┬──────────┬──────────┬──────────╮   ╭──────────┬──────────┬──────────┬──────────┬──────────╮
            //│          │          │          │          │          │   │          │          │          │          │          │
            &trans     &trans     &trans     &trans    &trans          &trans     &trans     &trans     &trans     &trans
            //├──────────┼──────────┼──────────┼──────────┼──────────┤   ├──────────┼──────────┼──────────┼──────────┼──────────┤
            //│          │          │          │          │          │   │          │          │          │          │
            &trans     &trans     &trans     &trans    &trans          &trans     &trans     &trans     &trans     &trans
            //├──────────┼──────────┼──────────┼──────────┼──────────┤   ├──────────┼──────────┼──────────┼──────────┼──────────┤
            //│          │          │          │          │          │   │          │          │          │          │          │
            &trans     &trans     &trans     &trans    &trans          &trans     &trans     &trans     &trans     &trans
            //╰──────────┴──────────┴──────────┼──────────┼──────────┤   ├──────────┼──────────┼──────────┴──────────┴──────────╯
                                                &trans     &trans         &trans     &trans
            //                                 ╰──────────┴──────────╯   ╰──────────┴──────────╯
            >;
        };
    };
};
